{#
/**
 * @file
 * State-of-the-art Doctor Console Dashboard template.
 * Built with responsive Tailwind CSS components for clinical workflows.
 */
#}
<div class="space-y-8">
  <!-- Doctor Profile Hero Banner -->
  <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-slate-900 via-teal-900 to-emerald-900 p-6 sm:p-8 text-white shadow-xl border border-teal-500/20">
    <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div class="flex items-start sm:items-center gap-5">
        <!-- Avatar with active badge -->
        <div class="relative flex-shrink-0">
          <div class="h-20 w-20 rounded-2xl bg-gradient-to-tr from-teal-500 to-emerald-400 p-1 shadow-lg shadow-teal-900/50">
            <div class="h-full w-full rounded-[14px] bg-slate-900 flex items-center justify-center text-white text-3xl font-black">
              🩺
            </div>
          </div>
          <span class="absolute -bottom-1 -right-1 h-5 w-5 rounded-full bg-emerald-500 border-2 border-slate-900 flex items-center justify-center" title="Online & Available">
            <span class="h-2 w-2 rounded-full bg-white animate-ping"></span>
          </span>
        </div>

        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white m-0">Dr. {{ doctor_name }}</h1>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/20 px-3 py-0.5 text-xs font-bold text-emerald-300 border border-emerald-500/30">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              {{ 'Verified Specialist'|t }}
            </span>
          </div>
          <p class="text-sm text-teal-200 font-medium">MBBS, FCPS • Senior Consultant (Cardiology & Internal Medicine)</p>
          <div class="mt-3 flex flex-wrap items-center gap-4 text-xs text-slate-300">
            <div class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              <span>{{ 'Chamber: Room 302, Central Hospital'|t }}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>{{ 'Today: 05:00 PM – 09:00 PM (15m slots)'|t }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Chamber Status Badge -->
      <div class="flex flex-row md:flex-col items-end justify-between md:justify-center gap-3">
        <div class="inline-flex items-center gap-2 rounded-xl bg-white/10 backdrop-blur-md px-4 py-2 border border-white/15">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs font-bold text-white tracking-wide uppercase">{{ 'Chamber: Open'|t }}</span>
        </div>
        <span class="text-[11px] text-teal-200/80">{{ 'Fee: ৳1,000 / consultation'|t }}</span>
      </div>
    </div>

    <!-- Decorative Glow -->
    <div class="absolute -right-16 -top-16 h-72 w-72 rounded-full bg-teal-500/10 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-16 left-1/3 h-56 w-56 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>
  </div>

  <!-- Key Metrics Row (4 Columns) -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Card 1: Today's Appointments -->
    <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{{ "Today's Queue"|t }}</span>
        <div class="h-9 w-9 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-3xl font-black text-slate-900">4</span>
        <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">{{ '1 In Chamber'|t }}</span>
      </div>
      <p class="mt-2 text-xs text-slate-600">{{ '3 upcoming slots remaining today'|t }}</p>
    </div>

    <!-- Card 2: Pending Confirmations -->
    <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{{ 'Pending Requests'|t }}</span>
        <div class="h-9 w-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-3xl font-black text-slate-900">2</span>
        <span class="text-xs font-semibold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md">{{ 'Action needed'|t }}</span>
      </div>
      <p class="mt-2 text-xs text-slate-600">{{ 'Patient bookings awaiting approval'|t }}</p>
    </div>

    <!-- Card 3: Today's Revenue -->
    <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{{ 'Est. Fees Today'|t }}</span>
        <div class="h-9 w-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-1.5">
        <span class="text-2xl font-black text-slate-900">৳ 4,000</span>
        <span class="text-xs font-semibold text-emerald-600">BDT</span>
      </div>
      <p class="mt-2 text-xs text-slate-600">{{ 'Based on 4 confirmed patient visits'|t }}</p>
    </div>

    <!-- Card 4: Slot Duration & Capacity -->
    <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{{ 'Slot Setting'|t }}</span>
        <div class="h-9 w-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-3xl font-black text-slate-900">15 <span class="text-lg font-bold text-slate-600">min</span></span>
      </div>
      <p class="mt-2 text-xs text-slate-600">{{ 'Max capacity: 16 patients / session'|t }}</p>
    </div>
  </div>

  <!-- Main Workstation Layout: 2/3 Patient Queue + 1/3 Chamber Controls -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column: Live Patient Queue (2 Cols) -->
    <div class="lg:col-span-2 space-y-6">
      <div class="rounded-2xl border border-slate-200/80 bg-white shadow-sm overflow-hidden">
        <!-- Header with Filter & Call Next -->
        <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-lg font-bold text-slate-900 m-0">{{ "Today's Patient Queue"|t }}</h2>
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-bold text-emerald-800">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                {{ 'Live Session'|t }}
              </span>
            </div>
            <p class="text-xs text-slate-600 mt-1">{{ 'Sunday, 13 September 2026 • Chamber Session: 05:00 PM – 09:00 PM'|t }}</p>
          </div>

          <div class="flex items-center gap-2">
            <button type="button" class="inline-flex items-center gap-1.5 rounded-xl bg-teal-600 hover:bg-teal-700 px-4 py-2 text-xs font-bold text-white shadow-sm transition-all shadow-teal-600/20">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              {{ 'Call Next Patient'|t }}
            </button>
          </div>
        </div>

        <!-- Sequential Patient Cards -->
        <div class="divide-y divide-slate-100">
          <!-- Patient 1: Completed -->
          <div class="p-5 hover:bg-slate-50/75 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="h-10 w-10 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center font-black text-sm flex-shrink-0">
                #01
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-bold text-slate-900 text-sm">Rahim Uddin</span>
                  <span class="text-xs text-slate-600">48 Y, Male</span>
                  <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600">APT-202609-001</span>
                </div>
                <p class="text-xs text-slate-600 mt-0.5">Chief Complaint: Hypertension check & routine prescription renewal</p>
                <div class="flex items-center gap-3 text-[11px] text-slate-600 mt-1.5">
                  <span class="font-medium text-slate-600">🕒 05:00 PM – 05:15 PM</span>
                  <span>•</span>
                  <span>Contact: 01712-345678</span>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 border border-emerald-200/50">
                ✓ {{ 'Completed'|t }}
              </span>
            </div>
          </div>

          <!-- Patient 2: In Chamber (Active) -->
          <div class="p-5 bg-teal-50/40 border-l-4 border-l-teal-600 hover:bg-teal-50/60 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="h-10 w-10 rounded-xl bg-teal-600 text-white flex items-center justify-center font-black text-sm flex-shrink-0 shadow-sm shadow-teal-600/30">
                #02
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-bold text-slate-900 text-sm">Nasreen Akhter</span>
                  <span class="text-xs text-slate-600">35 Y, Female</span>
                  <span class="inline-flex items-center rounded-full bg-teal-100 px-2 py-0.5 text-[11px] font-bold text-teal-800">APT-202609-002</span>
                </div>
                <p class="text-xs text-slate-700 mt-0.5 font-medium">Chief Complaint: Chest discomfort & shortness of breath after exertion</p>
                <div class="flex items-center gap-3 text-[11px] text-slate-600 mt-1.5">
                  <span class="font-semibold text-teal-700">🕒 05:15 PM – 05:30 PM (Current)</span>
                  <span>•</span>
                  <span>Contact: 01819-876543</span>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <span class="inline-flex items-center gap-1.5 rounded-lg bg-teal-100 px-3 py-1.5 text-xs font-bold text-teal-800">
                <span class="h-2 w-2 rounded-full bg-teal-600 animate-ping"></span>
                {{ 'In Chamber'|t }}
              </span>
              <button type="button" class="inline-flex items-center rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition-colors">
                {{ 'Mark Completed'|t }}
              </button>
            </div>
          </div>

          <!-- Patient 3: Confirmed (Next Up) -->
          <div class="p-5 hover:bg-slate-50/75 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="h-10 w-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center font-black text-sm flex-shrink-0">
                #03
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-bold text-slate-900 text-sm">Kamal Hossain</span>
                  <span class="text-xs text-slate-600">52 Y, Male</span>
                  <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600">APT-202609-003</span>
                </div>
                <p class="text-xs text-slate-600 mt-0.5">Chief Complaint: Post-angioplasty 6-month checkup & ECG review</p>
                <div class="flex items-center gap-3 text-[11px] text-slate-600 mt-1.5">
                  <span class="font-medium text-slate-700">🕒 05:30 PM – 05:45 PM (Next)</span>
                  <span>•</span>
                  <span>Contact: 01911-223344</span>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <span class="inline-flex items-center rounded-lg bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 border border-blue-200/50">
                {{ 'Confirmed'|t }}
              </span>
              <button type="button" class="inline-flex items-center rounded-lg border border-slate-200 hover:bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 transition-colors">
                {{ 'Call'|t }}
              </button>
            </div>
          </div>

          <!-- Patient 4: Confirmed -->
          <div class="p-5 hover:bg-slate-50/75 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="h-10 w-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center font-black text-sm flex-shrink-0">
                #04
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-bold text-slate-900 text-sm">Farhana Yasmin</span>
                  <span class="text-xs text-slate-600">29 Y, Female</span>
                  <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600">APT-202609-004</span>
                </div>
                <p class="text-xs text-slate-600 mt-0.5">Chief Complaint: Irregular heartbeat & anxiety palpitations</p>
                <div class="flex items-center gap-3 text-[11px] text-slate-600 mt-1.5">
                  <span class="font-medium text-slate-700">🕒 05:45 PM – 06:00 PM</span>
                  <span>•</span>
                  <span>Contact: 01678-998877</span>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <span class="inline-flex items-center rounded-lg bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 border border-blue-200/50">
                {{ 'Confirmed'|t }}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Chamber Management & Quick Controls (1 Col) -->
    <div class="space-y-6">
      <!-- Chamber Schedule Settings Card -->
      <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
          <h3 class="text-base font-bold text-slate-900 m-0">{{ 'Chamber Schedule'|t }}</h3>
          <span class="text-xs font-semibold text-teal-600 hover:text-teal-700 cursor-pointer">{{ 'Edit'|t }}</span>
        </div>

        <div class="space-y-3.5 text-xs text-slate-600">
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50">
            <span class="font-semibold text-slate-700">{{ 'Working Days'|t }}</span>
            <span class="font-bold text-slate-900">{{ 'Sat, Mon, Wed, Fri'|t }}</span>
          </div>
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50">
            <span class="font-semibold text-slate-700">{{ 'Chamber Hours'|t }}</span>
            <span class="font-bold text-slate-900">{{ '05:00 PM – 09:00 PM'|t }}</span>
          </div>
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50">
            <span class="font-semibold text-slate-700">{{ 'Slot Duration'|t }}</span>
            <span class="font-bold text-teal-700">{{ '15 Minutes'|t }}</span>
          </div>
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50">
            <span class="font-semibold text-slate-700">{{ 'Consultation Fee'|t }}</span>
            <span class="font-bold text-emerald-700">{{ '৳ 1,000 / visit'|t }}</span>
          </div>
        </div>
      </div>

      <!-- Quick Action Shortcuts -->
      <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm space-y-3">
        <h3 class="text-base font-bold text-slate-900 m-0 mb-4">{{ 'Doctor Shortcuts'|t }}</h3>

        <button type="button" class="w-full flex items-center justify-between p-3 rounded-xl border border-slate-200/80 hover:border-teal-500 hover:bg-teal-50/50 transition-all text-left group">
          <div class="flex items-center gap-3">
            <div class="h-8 w-8 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center font-bold">
              +
            </div>
            <div>
              <div class="text-xs font-bold text-slate-900">{{ 'Add Walk-in Patient'|t }}</div>
              <div class="text-[11px] text-slate-600">{{ 'Generate emergency slot token'|t }}</div>
            </div>
          </div>
          <svg class="h-4 w-4 text-slate-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>

        <button type="button" class="w-full flex items-center justify-between p-3 rounded-xl border border-slate-200/80 hover:border-amber-500 hover:bg-amber-50/50 transition-all text-left group">
          <div class="flex items-center gap-3">
            <div class="h-8 w-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
              🚫
            </div>
            <div>
              <div class="text-xs font-bold text-slate-900">{{ 'Block Date / Take Leave'|t }}</div>
              <div class="text-[11px] text-slate-600">{{ 'Prevent bookings on holiday'|t }}</div>
            </div>
          </div>
          <svg class="h-4 w-4 text-slate-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>
