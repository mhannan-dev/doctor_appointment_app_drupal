{#
/**
 * @file
 * Default theme implementation for the Patient Dashboard with Tailwind CSS.
 *
 * Available variables:
 * - user_name: The display name of the logged-in patient.
 * - upcoming_count: Number of upcoming appointments.
 * - completed_count: Number of completed consultations.
 * - pending_count: Number of pending booking requests.
 *
 * @ingroup themeable
 */
#}
<div class="doctor-appointment-wrapper max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  <!-- Welcome Banner -->
  <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-600 p-8 text-white shadow-xl">
    <div class="relative z-10 max-w-2xl">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3 py-1 text-xs font-semibold uppercase tracking-wider backdrop-blur-sm">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {{ 'Patient Portal'|t }}
      </span>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl text-white">
        {{ 'Welcome, @name 👋'|t({'@name': user_name}) }}
      </h1>
      <p class="mt-2 text-base text-blue-100 leading-relaxed">
        {{ 'Manage your upcoming consultations, view doctor schedules, and track your appointment booking requests in real time.'|t }}
      </p>
    </div>

    <!-- Background Decorative Circles -->
    <div class="absolute -right-12 -top-12 h-64 w-64 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
    <div class="absolute -bottom-8 right-32 h-48 w-48 rounded-full bg-cyan-400/20 blur-xl pointer-events-none"></div>
  </div>

  <!-- Key Metrics Grid -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <!-- Metric 1: Upcoming -->
    <div class="group relative overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md border-l-4 border-l-blue-600">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{{ 'Upcoming Appointments'|t }}</span>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-colors">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-4 flex items-baseline gap-2">
        <span class="text-3xl font-black text-slate-900">{{ upcoming_count }}</span>
        <span class="text-xs font-medium text-slate-500">{{ 'scheduled'|t }}</span>
      </div>
    </div>

    <!-- Metric 2: Completed -->
    <div class="group relative overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md border-l-4 border-l-emerald-500">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{{ 'Completed Consultations'|t }}</span>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-4 flex items-baseline gap-2">
        <span class="text-3xl font-black text-slate-900">{{ completed_count }}</span>
        <span class="text-xs font-medium text-slate-500">{{ 'past visits'|t }}</span>
      </div>
    </div>

    <!-- Metric 3: Pending -->
    <div class="group relative overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md border-l-4 border-l-amber-500">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{{ 'Pending Requests'|t }}</span>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-600 group-hover:bg-amber-600 group-hover:text-white transition-colors">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-4 flex items-baseline gap-2">
        <span class="text-3xl font-black text-slate-900">{{ pending_count }}</span>
        <span class="text-xs font-medium text-slate-500">{{ 'awaiting review'|t }}</span>
      </div>
    </div>
  </div>

  <!-- Appointments Queue & Actions -->
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
    <!-- Active Bookings List (2 Cols) -->
    <div class="lg:col-span-2 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
        <div>
          <h2 class="text-lg font-bold text-slate-900">{{ 'Your Appointments'|t }}</h2>
          <p class="text-xs text-slate-500">{{ 'Upcoming consultations and visit details'|t }}</p>
        </div>
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700">
          {{ 'Live Queue'|t }}
        </span>
      </div>

      <!-- Empty State -->
      <div class="flex flex-col items-center justify-center py-12 text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-blue-50 text-blue-500 mb-4">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-slate-900">{{ 'No appointments scheduled'|t }}</h3>
        <p class="mt-1 max-w-sm text-sm text-slate-500">{{ 'You do not have any active appointments. Pick a specialist doctor and select an available time slot.'|t }}</p>
        <div class="mt-6">
          <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            {{ 'Book Your First Appointment'|t }}
          </a>
        </div>
      </div>
    </div>

    <!-- Quick Actions Panel (1 Col) -->
    <div class="space-y-6">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-base font-bold text-slate-900 mb-4">{{ 'Quick Actions'|t }}</h2>
        <div class="space-y-3">
          <a href="/" class="flex items-center justify-between p-3.5 rounded-lg border border-slate-100 hover:border-blue-200 hover:bg-blue-50/50 transition-all group">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-100 text-blue-600 group-hover:scale-105 transition-transform">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-slate-800">{{ 'Find Doctors'|t }}</div>
                <div class="text-xs text-slate-500">{{ 'Browse by specialty'|t }}</div>
              </div>
            </div>
            <svg class="h-5 w-5 text-slate-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>

          <a href="/user" class="flex items-center justify-between p-3.5 rounded-lg border border-slate-100 hover:border-indigo-200 hover:bg-indigo-50/50 transition-all group">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600 group-hover:scale-105 transition-transform">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-slate-800">{{ 'My Profile'|t }}</div>
                <div class="text-xs text-slate-500">{{ 'Personal & contact info'|t }}</div>
              </div>
            </div>
            <svg class="h-5 w-5 text-slate-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Support & Help Card -->
      <div class="rounded-xl border border-blue-100 bg-gradient-to-br from-blue-50 to-indigo-50/50 p-5">
        <div class="flex items-start gap-3">
          <div class="rounded-lg bg-blue-600 p-2 text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-sm font-bold text-blue-950">{{ 'Need Medical Assistance?'|t }}</h4>
            <p class="mt-1 text-xs text-blue-800/80 leading-relaxed">{{ 'In case of emergency, please visit the nearest hospital or call your emergency hotline directly.'|t }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
