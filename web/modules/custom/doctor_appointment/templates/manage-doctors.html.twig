{#
/**
 * @file
 * Template for Manage Doctors page with table and + Create Doctor Profile action.
 */
#}
<div class="doctor-appointment-wrapper max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

  <!-- Top Breadcrumb & Quick Nav -->
  <nav class="flex items-center gap-2 text-xs font-medium text-slate-500">
    <a href="/home" class="hover:text-teal-600 transition-colors">{{ 'Home'|t }}</a>
    <span>/</span>
    <a href="/clinic-admin/dashboard" class="hover:text-teal-600 transition-colors">{{ 'Clinic Admin'|t }}</a>
    <span>/</span>
    <span class="text-slate-900 font-semibold">{{ 'Manage Doctors'|t }}</span>
  </nav>

  <!-- Page Header & Action Bar (With + Create Doctor Profile Button on Right) -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-sm">
    <div>
      <div class="flex items-center gap-2.5 mb-1.5">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-50 px-3 py-1 text-xs font-bold text-teal-700 border border-teal-200/60">
          <span class="h-2 w-2 rounded-full bg-teal-500 animate-pulse"></span>
          {{ 'Clinical Specialists'|t }}
        </span>
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">
          <span id="doctor-count-badge">{{ total_doctors }}</span> {{ 'Registered'|t }}
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
        {{ 'Manage Doctors'|t }}
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        {{ 'Directory of registered medical specialists, qualifications, chamber locations, and consultation fees.'|t }}
      </p>
    </div>

    <!-- Right Side: "+ Create Doctor Profile" Button -->
    <div class="flex items-center gap-3 flex-shrink-0">
      <a href="{{ create_url }}" class="inline-flex items-center gap-2 text-sm font-bold text-white px-5 py-3 rounded-xl bg-gradient-to-r from-teal-600 to-emerald-600 hover:from-teal-700 hover:to-emerald-700 shadow-md shadow-teal-600/25 transition-all hover:scale-105 active:scale-95 no-underline">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>{{ 'Create Doctor Profile'|t }}</span>
      </a>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="relative w-full sm:max-w-md">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <input
        type="text"
        id="doctor-search-input"
        placeholder="{{ 'Search by doctor name, specialty, degree, or chamber...'|t }}"
        class="w-full pl-10 pr-4 py-2 text-sm bg-slate-50 border border-slate-200 rounded-lg text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all"
      />
    </div>

    <div class="flex items-center gap-2 text-xs text-slate-500 w-full sm:w-auto justify-between sm:justify-end">
      <span id="search-results-info">
        {{ 'Showing all'|t }} <strong class="text-slate-800" id="visible-count">{{ total_doctors }}</strong> {{ 'doctors'|t }}
      </span>
      <button
        type="button"
        id="clear-search-btn"
        class="hidden text-teal-600 hover:text-teal-800 font-semibold underline text-xs ml-2 cursor-pointer"
      >
        {{ 'Clear'|t }}
      </button>
    </div>
  </div>

  <!-- Doctors Table Container -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    {% if doctors is empty %}
      <!-- Empty State -->
      <div class="p-12 text-center space-y-4">
        <div class="mx-auto h-16 w-16 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900">{{ 'No Doctor Profiles Yet'|t }}</h3>
        <p class="text-sm text-slate-500 max-w-md mx-auto">
          {{ 'No doctors have been registered into the portal yet. Click the button below to onboard the first specialist.'|t }}
        </p>
        <div class="pt-2">
          <a href="{{ create_url }}" class="inline-flex items-center gap-2 text-sm font-bold text-white px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 shadow-sm shadow-teal-600/20 transition-colors no-underline">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
            </svg>
            {{ 'Create Doctor Profile'|t }}
          </a>
        </div>
      </div>
    {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" id="doctors-table">
          <thead>
            <tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
              <th scope="col" class="py-3.5 px-4 sm:px-6">{{ 'Doctor Name'|t }}</th>
              <th scope="col" class="py-3.5 px-4">{{ 'Specialty'|t }}</th>
              <th scope="col" class="py-3.5 px-4">{{ 'Degrees / Qualifications'|t }}</th>
              <th scope="col" class="py-3.5 px-4">{{ 'Experience'|t }}</th>
              <th scope="col" class="py-3.5 px-4">{{ 'Chambers'|t }}</th>
              <th scope="col" class="py-3.5 px-4">{{ 'Fee'|t }}</th>
              <th scope="col" class="py-3.5 px-4 sm:px-6 text-right">{{ 'Actions'|t }}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm">
            {% for doc in doctors %}
              <tr class="doctor-row hover:bg-slate-50/60 transition-colors" data-search-text="{{ doc.title|lower }} {{ doc.specialty|lower }} {{ doc.degrees|join(' ')|lower }} {{ doc.chambers|join(' ')|lower }}">
                <!-- Doctor Name & Initials -->
                <td class="py-4 px-4 sm:px-6">
                  <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-teal-500 to-emerald-600 flex items-center justify-center text-white font-black text-xs shadow-sm flex-shrink-0">
                      {{ doc.initials }}
                    </div>
                    <div>
                      <a href="{{ doc.view_url }}" class="font-bold text-slate-900 hover:text-teal-600 transition-colors no-underline block leading-snug">
                        {{ doc.title }}
                      </a>
                      <span class="text-[11px] text-slate-600 flex items-center gap-1 mt-0.5">
                        <span class="h-1.5 w-1.5 rounded-full {{ doc.status ? 'bg-emerald-500' : 'bg-slate-400' }}"></span>
                        {{ doc.status ? 'Active'|t : 'Unpublished'|t }}
                      </span>
                    </div>
                  </div>
                </td>

                <!-- Specialty -->
                <td class="py-4 px-4">
                  {% if doc.specialty %}
                    <span class="inline-flex items-center rounded-lg bg-teal-50 px-2.5 py-1 text-xs font-bold text-teal-700 border border-teal-200/60">
                      {{ doc.specialty }}
                    </span>
                  {% else %}
                    <span class="text-xs text-slate-400 italic">{{ 'Not specified'|t }}</span>
                  {% endif %}
                </td>

                <!-- Degrees -->
                <td class="py-4 px-4">
                  {% if doc.degrees is not empty %}
                    <div class="flex flex-wrap gap-1.5 max-w-xs">
                      {% for deg in doc.degrees %}
                        <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700 border border-slate-200/60">
                          {{ deg }}
                        </span>
                      {% endfor %}
                    </div>
                  {% else %}
                    <span class="text-xs text-slate-400 italic">—</span>
                  {% endif %}
                </td>

                <!-- Experience -->
                <td class="py-4 px-4 whitespace-nowrap">
                  {% if doc.experience is not null %}
                    <span class="inline-flex items-center gap-1 font-semibold text-slate-800 text-xs bg-amber-50 text-amber-800 px-2.5 py-1 rounded-md border border-amber-200/50">
                      ⭐ {{ doc.experience }} {{ 'Years'|t }}
                    </span>
                  {% else %}
                    <span class="text-xs text-slate-400 italic">—</span>
                  {% endif %}
                </td>

                <!-- Chambers -->
                <td class="py-4 px-4">
                  {% if doc.chambers is not empty %}
                    <div class="space-y-1.5 max-w-xs">
                      {% for chamber in doc.chambers %}
                        <div class="flex items-start gap-1.5 text-xs text-slate-600">
                          <svg class="h-3.5 w-3.5 text-slate-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          </svg>
                          <span class="line-clamp-2">{{ chamber }}</span>
                        </div>
                      {% endfor %}
                    </div>
                  {% else %}
                    <span class="text-xs text-slate-400 italic">—</span>
                  {% endif %}
                </td>

                <!-- Fee -->
                <td class="py-4 px-4 whitespace-nowrap">
                  {% if doc.fee is not null %}
                    <div class="font-extrabold text-slate-900 text-xs">
                      <span class="text-teal-600">৳</span> {{ doc.fee }}
                      <span class="text-[10px] font-medium text-slate-600 block">BDT / visit</span>
                    </div>
                  {% else %}
                    <span class="text-xs text-slate-400 italic">—</span>
                  {% endif %}
                </td>

                <!-- Actions -->
                <td class="py-4 px-4 sm:px-6 text-right whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5 justify-end">
                    <a href="{{ doc.edit_url }}" class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-2.5 py-1.5 rounded-lg transition-colors no-underline" title="{{ 'Edit Profile'|t }}">
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                      {{ 'Edit'|t }}
                    </a>

                    <a href="{{ doc.view_url }}" class="inline-flex items-center gap-1 text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 px-2.5 py-1.5 rounded-lg transition-colors no-underline" title="{{ 'View Profile'|t }}">
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                      </svg>
                      {{ 'View'|t }}
                    </a>

                    <a href="{{ doc.delete_url }}" class="inline-flex items-center text-xs font-semibold text-red-600 hover:text-red-800 hover:bg-red-50 p-1.5 rounded-lg transition-colors no-underline" title="{{ 'Delete'|t }}">
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    </a>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- No match search message -->
      <div id="no-search-results" class="hidden p-8 text-center text-sm text-slate-500">
        {{ 'No doctors match your search query.'|t }}
      </div>
    {% endif %}
  </div>
</div>

<!-- Client-side Real-time Search Script -->
<script>
  (function () {
    const searchInput = document.getElementById('doctor-search-input');
    const clearBtn = document.getElementById('clear-search-btn');
    const rows = document.querySelectorAll('.doctor-row');
    const visibleCount = document.getElementById('visible-count');
    const noResults = document.getElementById('no-search-results');

    if (!searchInput || !rows.length) return;

    searchInput.addEventListener('input', function () {
      const q = this.value.trim().toLowerCase();
      let count = 0;

      rows.forEach(row => {
        const text = row.getAttribute('data-search-text') || '';
        if (!q || text.includes(q)) {
          row.style.display = '';
          count++;
        } else {
          row.style.display = 'none';
        }
      });

      if (visibleCount) visibleCount.textContent = count;
      if (clearBtn) clearBtn.classList.toggle('hidden', !q);
      if (noResults) noResults.classList.toggle('hidden', count > 0);
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input'));
        searchInput.focus();
      });
    }
  })();
</script>
