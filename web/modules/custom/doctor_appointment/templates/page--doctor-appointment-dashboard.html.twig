{#
/**
 * @file
 * Standalone, modern full-width layout for Doctor Appointment dashboards.
 * Bypasses core theme constraints to provide a professional application shell.
 */
#}
<div class="doctor-appointment-shell min-h-screen flex flex-col bg-slate-50 text-slate-800 antialiased font-sans">
  <!-- Modern Application Header -->
  <header class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-50 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Brand & Portal Type -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 text-slate-900 no-underline group">
          <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-teal-600 via-emerald-600 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-teal-500/20 group-hover:scale-105 transition-transform">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
            </svg>
          </div>
          <div>
            <div class="font-extrabold text-lg tracking-tight text-slate-900 leading-none">MediCare<span class="text-teal-600">Hub</span></div>
            <div class="text-[11px] font-semibold text-slate-600 uppercase tracking-wider mt-0.5">{{ 'Appointment System'|t }}</div>
          </div>
        </a>
      </div>

      {% if is_homepage %}
        <!-- Marketing Navigation -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
          <a href="#how-it-works" class="hover:text-teal-600 transition-colors">{{ 'How It Works'|t }}</a>
          <a href="#specialties" class="hover:text-teal-600 transition-colors">{{ 'Specialties'|t }}</a>
          <a href="#why-us" class="hover:text-teal-600 transition-colors">{{ 'Why Us'|t }}</a>
        </nav>
      {% else %}
        <!-- Center Date / Status Indicator -->
        <div class="hidden md:flex items-center gap-2 text-xs font-medium text-slate-700 bg-slate-100/80 px-3.5 py-1.5 rounded-full border border-slate-200/60">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>{{ 'System Operational'|t }}</span>
          <span class="text-slate-300">•</span>
          <span class="text-slate-700">Drupal 11 Enterprise</span>
        </div>
      {% endif %}

      <!-- User Nav Actions -->
      <div class="flex items-center gap-3">
        <a href="/home" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-teal-600 px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          {{ 'Home'|t }}
        </a>

        {% if logged_in %}
          <a href="/node/add/doctor_profile" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-white px-3 py-2 rounded-lg bg-teal-600 hover:bg-teal-700 shadow-sm shadow-teal-600/20 transition-all hover:scale-105">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
            </svg>
            {{ 'Create Doctor Profile'|t }}
          </a>

          <a href="/user" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 hover:text-teal-700 px-3 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 transition-colors">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            {{ 'Account'|t }}
          </a>

          <a href="/user/logout" class="inline-flex items-center gap-1.5 text-xs font-bold text-red-600 hover:text-red-700 px-3 py-2 rounded-lg hover:bg-red-50 transition-colors">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            {{ 'Log out'|t }}
          </a>
        {% else %}
          <a href="/user/login" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 hover:text-teal-700 px-3 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 transition-colors">
            {{ 'Log in'|t }}
          </a>

          <a href="/user/register" class="inline-flex items-center gap-1.5 text-xs font-bold text-white px-3.5 py-2 rounded-lg bg-teal-600 hover:bg-teal-700 shadow-sm shadow-teal-600/20 transition-colors">
            {{ 'Sign Up'|t }}
          </a>
        {% endif %}
      </div>
    </div>
  </header>

  <!-- Main App Viewport -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    {{ page.content }}
  </main>

  <!-- Clean Minimal Footer -->
  <footer class="bg-white border-t border-slate-200/80 py-6 text-center text-xs text-slate-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="font-bold text-slate-700">MediCare Hub</span>
        <span>•</span>
        <span>{{ 'Doctor Appointment Booking System'|t }}</span>
      </div>
      <div class="text-slate-600">
        {{ 'Designed with modern Tailwind CSS & Drupal 11 Architecture'|t }}
      </div>
    </div>
  </footer>
</div>
