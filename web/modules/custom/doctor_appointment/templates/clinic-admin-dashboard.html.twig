{#
/**
 * @file
 * Default theme implementation for the Clinic Admin Dashboard with Tailwind CSS.
 *
 * @ingroup themeable
 */
#}
<div class="doctor-appointment-wrapper max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  <!-- Admin Banner -->
  <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-purple-800 via-indigo-700 to-blue-700 p-8 text-white shadow-xl">
    <div class="relative z-10 max-w-2xl">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3 py-1 text-xs font-semibold uppercase tracking-wider backdrop-blur-sm">
        <span class="h-2 w-2 rounded-full bg-purple-300"></span>
        {{ 'Clinic Administration'|t }}
      </span>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl text-white">
        {{ 'Clinic Administration Console'|t }}
      </h1>
      <p class="mt-2 text-base text-purple-100 leading-relaxed">
        {{ 'High-level administration for doctor verification, chamber allocation, and global appointment records.'|t }}
      </p>
    </div>

    <!-- Background Decorative Elements -->
    <div class="absolute -right-8 -top-8 h-56 w-56 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
  </div>

  <!-- Admin Controls -->
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 mb-4">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
      </div>
      <h3 class="text-base font-bold text-slate-900">{{ 'Doctor Roster'|t }}</h3>
      <p class="mt-1 text-xs text-slate-500">{{ 'Review and onboard medical specialists and approve chamber listings.'|t }}</p>
      <a href="/admin/content" class="mt-4 inline-flex items-center text-xs font-semibold text-indigo-600 hover:text-indigo-800">
        {{ 'Manage Doctors'|t }} →
      </a>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-50 text-purple-600 mb-4">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
        </svg>
      </div>
      <h3 class="text-base font-bold text-slate-900">{{ 'Specialties & Chambers'|t }}</h3>
      <p class="mt-1 text-xs text-slate-500">{{ 'Configure taxonomy categories for medical departments and clinic rooms.'|t }}</p>
      <a href="/admin/structure/taxonomy" class="mt-4 inline-flex items-center text-xs font-semibold text-purple-600 hover:text-purple-800">
        {{ 'Manage Taxonomies'|t }} →
      </a>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600 mb-4">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
      </div>
      <h3 class="text-base font-bold text-slate-900">{{ 'Global Bookings'|t }}</h3>
      <p class="mt-1 text-xs text-slate-500">{{ 'Cross-chamber audit log, overall statistics, and booking overrides.'|t }}</p>
      <a href="/admin/reports" class="mt-4 inline-flex items-center text-xs font-semibold text-blue-600 hover:text-blue-800">
        {{ 'View Logs & Stats'|t }} →
      </a>
    </div>
  </div>
</div>
