{#
/**
 * @file
 * Modern User Profile page layout for MediCare Hub (/user/{id}, /user/1).
 * Replaces default Olivero user profile with a clinical enterprise account workspace.
 */
#}
<div class="doctor-appointment-shell min-h-screen flex flex-col bg-slate-50 text-slate-800 antialiased font-sans">

  <!-- Application Header -->
  <header class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-50 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Brand & Portal Type -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 text-slate-900 no-underline group">
          <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-teal-600 via-emerald-600 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-teal-500/20 group-hover:scale-105 transition-transform">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
            </svg>
          </div>
          <div>
            <div class="font-extrabold text-lg tracking-tight text-slate-900 leading-none">MediCare<span class="text-teal-600">Hub</span></div>
            <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider mt-0.5">{{ 'User Account Profile'|t }}</div>
          </div>
        </a>
      </div>

      <!-- Quick Nav Links -->
      <div class="flex items-center gap-3">
        <a href="/" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-teal-600 px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          {{ 'Home'|t }}
        </a>

        {% if profile_user.dashboard_url %}
          <a href="{{ profile_user.dashboard_url }}" class="inline-flex items-center gap-1.5 text-xs font-bold text-white px-3.5 py-2 rounded-lg bg-teal-600 hover:bg-teal-700 shadow-sm shadow-teal-600/20 transition-colors">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
            </svg>
            {{ profile_user.dashboard_label }}
          </a>
        {% endif %}

        <a href="/user/logout" class="inline-flex items-center gap-1.5 text-xs font-bold text-red-600 hover:text-red-700 px-3 py-2 rounded-lg hover:bg-red-50 transition-colors">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          {{ 'Log out'|t }}
        </a>
      </div>
    </div>
  </header>

  <!-- Main Viewport -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Messages Slot -->
    {% if page.highlighted %}
      <div class="da-auth-messages">
        {{ page.highlighted }}
      </div>
    {% endif %}

    <!-- Profile Hero Card -->
    <section class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-900 via-teal-950 to-slate-900 text-white p-8 sm:p-10 shadow-xl border border-white/10">
      <div class="absolute inset-0 bg-[radial-gradient(circle,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[length:20px_20px]"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <!-- User Bio / Avatar -->
        <div class="flex items-center gap-5">
          <div class="relative">
            <div class="h-20 w-20 rounded-2xl bg-gradient-to-tr from-teal-500 to-emerald-400 flex items-center justify-center text-white text-3xl font-black shadow-lg shadow-teal-500/30">
              {{ profile_user.initial|default('U') }}
            </div>
            <span class="absolute -bottom-1 -right-1 h-5 w-5 rounded-full bg-emerald-500 border-2 border-slate-900 flex items-center justify-center" title="Active Account">
              <span class="h-2 w-2 rounded-full bg-white animate-ping"></span>
            </span>
          </div>

          <div class="space-y-1">
            <div class="flex items-center gap-2 flex-wrap">
              <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white capitalize">
                {{ profile_user.name|default('User') }}
              </h1>
              {% if profile_user.is_admin %}
                <span class="inline-flex items-center rounded-full bg-red-500/20 px-2.5 py-0.5 text-xs font-bold text-red-300 ring-1 ring-red-500/40">
                  ⚡ Administrator
                </span>
              {% elseif profile_user.is_doctor %}
                <span class="inline-flex items-center rounded-full bg-teal-500/20 px-2.5 py-0.5 text-xs font-bold text-teal-300 ring-1 ring-teal-500/40">
                  👨‍⚕️ Medical Specialist
                </span>
              {% elseif profile_user.is_patient %}
                <span class="inline-flex items-center rounded-full bg-blue-500/20 px-2.5 py-0.5 text-xs font-bold text-blue-300 ring-1 ring-blue-500/40">
                  🩺 Verified Patient
                </span>
              {% endif %}
            </div>

            <p class="text-xs sm:text-sm text-slate-300 flex items-center gap-3">
              <span>📧 {{ profile_user.email|default('No email provided') }}</span>
              <span>•</span>
              <span>UID: #{{ profile_user.id|default(1) }}</span>
              <span>•</span>
              <span>Member since {{ profile_user.created|default('Today') }}</span>
            </p>
          </div>
        </div>

        <!-- Hero Actions -->
        <div class="flex items-center gap-3 flex-wrap">
          {% if profile_user.dashboard_url %}
            <a href="{{ profile_user.dashboard_url }}" class="inline-flex items-center gap-2 rounded-xl bg-teal-400 hover:bg-teal-300 px-5 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-teal-500/30 transition-all hover:-translate-y-0.5">
              <span>{{ 'Open'|t }} {{ profile_user.dashboard_label }}</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          {% endif %}

          <a href="/user/{{ profile_user.id|default(1) }}/edit" class="inline-flex items-center gap-2 rounded-xl bg-white/10 hover:bg-white/20 px-4 py-3 text-sm font-semibold text-white border border-white/15 backdrop-blur-sm transition-all">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
            {{ 'Edit Profile'|t }}
          </a>
        </div>
      </div>
    </section>

    <!-- 3-Column Workspace Overview -->
    <div class="da-profile-grid grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- Column 1: System Portals & Navigation -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-teal-600"></span>
            {{ 'System Portals'|t }}
          </h2>
          <span class="text-xs text-slate-400 font-medium">Direct Access</span>
        </div>

        <div class="space-y-2.5">
          <a href="/doctor/dashboard" class="group flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50/70 hover:bg-teal-50/50 hover:border-teal-200 transition-all">
            <div class="flex items-center gap-3">
              <span class="text-lg">👨‍⚕️</span>
              <div>
                <div class="text-xs font-bold text-slate-800 group-hover:text-teal-700">{{ 'Doctor Workstation'|t }}</div>
                <div class="text-[11px] text-slate-500">{{ 'Queue management & status'|t }}</div>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>

          <a href="/patient/dashboard" class="group flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50/70 hover:bg-teal-50/50 hover:border-teal-200 transition-all">
            <div class="flex items-center gap-3">
              <span class="text-lg">🩺</span>
              <div>
                <div class="text-xs font-bold text-slate-800 group-hover:text-teal-700">{{ 'Patient Portal'|t }}</div>
                <div class="text-[11px] text-slate-500">{{ 'Bookings & appointment history'|t }}</div>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>

          <a href="/clinic-admin/dashboard" class="group flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50/70 hover:bg-teal-50/50 hover:border-teal-200 transition-all">
            <div class="flex items-center gap-3">
              <span class="text-lg">🏢</span>
              <div>
                <div class="text-xs font-bold text-slate-800 group-hover:text-teal-700">{{ 'Clinic Administration'|t }}</div>
                <div class="text-[11px] text-slate-500">{{ 'Chambers, fees & doctors'|t }}</div>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>

          <a href="/" class="group flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50/70 hover:bg-teal-50/50 hover:border-teal-200 transition-all">
            <div class="flex items-center gap-3">
              <span class="text-lg">🏠</span>
              <div>
                <div class="text-xs font-bold text-slate-800 group-hover:text-teal-700">{{ 'Public Landing Page'|t }}</div>
                <div class="text-[11px] text-slate-500">{{ 'Search specialists & marketing'|t }}</div>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Column 2: Account Details & Security -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-600"></span>
            {{ 'Account & Security'|t }}
          </h2>
          <span class="text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full font-bold">Active</span>
        </div>

        <div class="space-y-3 text-xs">
          <div class="flex items-center justify-between py-1.5 border-b border-slate-50">
            <span class="text-slate-500 font-medium">{{ 'Account Status'|t }}</span>
            <span class="font-bold text-emerald-700 flex items-center gap-1">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              {{ 'Verified & Active'|t }}
            </span>
          </div>

          <div class="flex items-center justify-between py-1.5 border-b border-slate-50">
            <span class="text-slate-500 font-medium">{{ 'Assigned Roles'|t }}</span>
            <span class="font-bold text-slate-800 capitalize">
              {{ profile_user.roles|join(', ')|default('authenticated') }}
            </span>
          </div>

          <div class="flex items-center justify-between py-1.5 border-b border-slate-50">
            <span class="text-slate-500 font-medium">{{ 'Security Protocol'|t }}</span>
            <span class="font-bold text-slate-800">256-Bit SSL · Drupal 11</span>
          </div>

          <div class="flex items-center justify-between py-1.5 border-b border-slate-50">
            <span class="text-slate-500 font-medium">{{ 'Password Standard'|t }}</span>
            <span class="font-bold text-slate-800">Test@1234 (Active)</span>
          </div>

          <div class="pt-2">
            <a href="/user/{{ profile_user.id|default(1) }}/edit" class="w-full inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 py-2.5 font-bold text-slate-700 transition-colors">
              <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              {{ 'Change Password or Email'|t }}
            </a>
          </div>
        </div>
      </div>

      <!-- Column 3: Administration Tools (if Admin/Clinic Admin) -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-blue-600"></span>
            {{ 'Admin Operations'|t }}
          </h2>
          <span class="text-xs text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full font-bold">Management</span>
        </div>

        <div class="space-y-2.5">
          <a href="/admin/people" class="group flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50/70 hover:bg-blue-50/50 hover:border-blue-200 transition-all">
            <div class="flex items-center gap-3">
              <span class="text-lg">👥</span>
              <div>
                <div class="text-xs font-bold text-slate-800 group-hover:text-blue-700">{{ 'User Management'|t }}</div>
                <div class="text-[11px] text-slate-500">{{ 'Doctors, patients & roles'|t }}</div>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>

          <a href="/admin/structure" class="group flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50/70 hover:bg-blue-50/50 hover:border-blue-200 transition-all">
            <div class="flex items-center gap-3">
              <span class="text-lg">⚙️</span>
              <div>
                <div class="text-xs font-bold text-slate-800 group-hover:text-blue-700">{{ 'System Architecture'|t }}</div>
                <div class="text-[11px] text-slate-500">{{ 'Content types, fields & views'|t }}</div>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>

          <a href="/admin/config/development/performance" class="group flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50/70 hover:bg-blue-50/50 hover:border-blue-200 transition-all">
            <div class="flex items-center gap-3">
              <span class="text-lg">⚡</span>
              <div>
                <div class="text-xs font-bold text-slate-800 group-hover:text-blue-700">{{ 'Performance & Caching'|t }}</div>
                <div class="text-[11px] text-slate-500">{{ 'Clear cache & aggregation'|t }}</div>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>

          <a href="/admin/reports/dblog" class="group flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50/70 hover:bg-blue-50/50 hover:border-blue-200 transition-all">
            <div class="flex items-center gap-3">
              <span class="text-lg">📊</span>
              <div>
                <div class="text-xs font-bold text-slate-800 group-hover:text-blue-700">{{ 'Recent Log Messages'|t }}</div>
                <div class="text-[11px] text-slate-500">{{ 'Watchdog logs & audit trail'|t }}</div>
              </div>
            </div>
            <span class="text-slate-400 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Collapsible Native Drupal Elements (Content / Tabs / Extra Fields) -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">{{ 'Drupal Core Account Details'|t }}</div>
      <div class="da-profile-core-content text-sm text-slate-600">
        {{ page.content }}
      </div>
    </div>

  </main>

  <!-- Clean Minimal Footer -->
  <footer class="bg-white border-t border-slate-200/80 py-6 text-center text-xs text-slate-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="font-bold text-slate-700">MediCare Hub</span>
        <span>•</span>
        <span>{{ 'Doctor Appointment Booking System'|t }}</span>
      </div>
      <div class="text-slate-500">
        {{ 'User Account Workspace · Drupal 11 Architecture'|t }}
      </div>
    </div>
  </footer>

</div>
