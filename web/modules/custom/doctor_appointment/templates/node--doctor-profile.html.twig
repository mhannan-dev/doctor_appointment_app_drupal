{#
/**
 * @file
 * Template for Doctor Profile (node--doctor-profile.html.twig).
 * MediCareHub modern Tailwind CSS design for doctor canonical view.
 */
#}
<article{{ attributes.addClass('doctor-profile-detail max-w-6xl mx-auto space-y-8') }}>

  <!-- Top Navigation & Quick Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-2 border-b border-slate-200/80">
    <nav class="flex items-center gap-2 text-xs font-medium text-slate-500">
      <a href="/home" class="hover:text-teal-600 transition-colors no-underline">{{ 'Home'|t }}</a>
      <span class="text-slate-300">/</span>
      <a href="/admin/manage-doctors" class="hover:text-teal-600 transition-colors no-underline">{{ 'Manage Doctors'|t }}</a>
      <span class="text-slate-300">/</span>
      <span class="text-slate-900 font-semibold truncate max-w-[200px] sm:max-w-xs">{{ doctor_data.title }}</span>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/admin/manage-doctors" class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-700 hover:text-teal-800 bg-teal-50 hover:bg-teal-100 px-3.5 py-1.5 rounded-full border border-teal-200/60 no-underline transition-colors shadow-sm">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        {{ 'Back to Manage Doctors'|t }}
      </a>
      {% if doctor_data.can_edit and doctor_data.edit_url %}
        <a href="{{ doctor_data.edit_url }}" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-100 px-3.5 py-1.5 rounded-full border border-slate-300 no-underline transition-colors shadow-sm">
          <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
          {{ 'Edit Profile'|t }}
        </a>
      {% endif %}
    </div>
  </div>

  <!-- Hero Profile Card -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden relative">
    <!-- Top Gradient Accent Bar -->
    <div class="h-24 sm:h-32 bg-gradient-to-r from-teal-600 via-emerald-600 to-cyan-600 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle,rgba(255,255,255,0.15)_1px,transparent_1px)] bg-[length:20px_20px] opacity-40"></div>
    </div>

    <!-- Main Doctor Info -->
    <div class="px-6 sm:px-10 pb-8 pt-0 relative">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 -mt-12 sm:-mt-16">
        <!-- Avatar & Core Info -->
        <div class="flex flex-col sm:flex-row items-center sm:items-end gap-5 text-center sm:text-left">
          <!-- Big Avatar -->
          <div class="relative">
            <div class="h-24 w-24 sm:h-32 sm:w-32 rounded-2xl bg-gradient-to-tr from-teal-500 to-emerald-600 p-1 shadow-xl ring-4 ring-white flex items-center justify-center text-white text-3xl sm:text-4xl font-black">
              {{ doctor_data.initials }}
            </div>
            <span class="absolute bottom-1 right-1 h-5 w-5 rounded-full bg-emerald-500 border-2 border-white ring-1 ring-emerald-200 flex items-center justify-center" title="{{ 'Active Specialist'|t }}">
              <svg class="h-3 w-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </span>
          </div>

          <!-- Titles & Badges -->
          <div class="space-y-2">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-50 px-3 py-1 text-xs font-bold text-teal-700 border border-teal-200/80">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                {{ doctor_data.specialty ?: 'Medical Specialist'|t }}
              </span>
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200/60">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                {{ 'Available for Booking'|t }}
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 leading-tight">
              {{ doctor_data.title }}
            </h1>

            {% if doctor_data.degrees is not empty %}
              <div class="flex flex-wrap items-center justify-center sm:justify-start gap-1.5 pt-0.5">
                {% for deg in doctor_data.degrees %}
                  <span class="inline-flex items-center rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 border border-slate-200/80">
                    {{ deg }}
                  </span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>

        <!-- Quick Primary Action -->
        <div class="flex items-center justify-center sm:justify-end gap-3 flex-shrink-0">
          <a href="#chambers-section" class="inline-flex items-center justify-center gap-2 text-sm font-bold text-white px-6 py-3.5 rounded-xl bg-gradient-to-r from-teal-600 to-emerald-600 hover:from-teal-700 hover:to-emerald-700 shadow-md shadow-teal-600/30 hover:shadow-lg hover:-translate-y-0.5 transition-all no-underline">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span>{{ 'Book Appointment'|t }}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Key Highlights Statistics Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Experience -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
      <div class="h-12 w-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center flex-shrink-0">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <div>
        <div class="text-xl sm:text-2xl font-black text-slate-900 leading-none">
          {{ doctor_data.experience ?: '—' }} {% if doctor_data.experience %}<span class="text-xs font-bold text-slate-500">{{ 'Years'|t }}</span>{% endif %}
        </div>
        <div class="text-xs font-semibold text-slate-500 mt-1">{{ 'Experience'|t }}</div>
      </div>
    </div>

    <!-- Consultation Fee -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
      <div class="h-12 w-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
      </div>
      <div>
        <div class="text-xl sm:text-2xl font-black text-slate-900 leading-none">
          {% if doctor_data.fee %}৳{{ doctor_data.fee }}{% else %}—{% endif %}
        </div>
        <div class="text-xs font-semibold text-slate-500 mt-1">{{ 'Consultation Fee'|t }}</div>
      </div>
    </div>

    <!-- Chambers Count -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
      <div class="h-12 w-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
      </div>
      <div>
        <div class="text-xl sm:text-2xl font-black text-slate-900 leading-none">
          {{ doctor_data.chambers|length }} <span class="text-xs font-bold text-slate-500">{{ 'Chambers'|t }}</span>
        </div>
        <div class="text-xs font-semibold text-slate-500 mt-1">{{ 'Visiting Locations'|t }}</div>
      </div>
    </div>

    <!-- Verification -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
      <div class="h-12 w-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center flex-shrink-0">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
      </div>
      <div>
        <div class="text-base sm:text-lg font-black text-slate-900 leading-none">
          {{ 'Verified'|t }}
        </div>
        <div class="text-xs font-semibold text-emerald-600 mt-1 flex items-center gap-1">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          {{ 'MediCareHub Certified'|t }}
        </div>
      </div>
    </div>
  </div>

  <!-- 2-Column Main Content Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Left Main Column (2/3) -->
    <div class="lg:col-span-2 space-y-8">

      <!-- Chamber Locations Section -->
      <div id="chambers-section" class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <h2 class="text-xl font-black text-slate-900">{{ 'Chamber Locations'|t }}</h2>
              <p class="text-xs text-slate-500">{{ 'Available clinical visiting hospitals & chamber addresses'|t }}</p>
            </div>
          </div>
          <span class="text-xs font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full border border-teal-200/60">
            {{ doctor_data.chambers|length }} {{ 'Addresses'|t }}
          </span>
        </div>

        {% if doctor_data.chambers is empty %}
          <p class="text-sm text-slate-400 italic py-4">{{ 'No chamber addresses have been listed yet.'|t }}</p>
        {% else %}
          <div class="space-y-4">
            {% for chamber in doctor_data.chambers %}
              <div class="p-5 rounded-2xl border border-slate-200/70 bg-slate-50/50 hover:bg-white hover:border-teal-300 hover:shadow-sm transition-all group">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-start gap-3.5">
                    <div class="h-9 w-9 rounded-xl bg-white border border-slate-200 text-teal-600 flex items-center justify-center flex-shrink-0 mt-0.5 group-hover:border-teal-300 group-hover:bg-teal-50 transition-colors">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    </div>
                    <div>
                      <h3 class="text-sm font-bold text-slate-900 leading-snug">
                        {{ chamber }}
                      </h3>
                      <div class="flex flex-wrap items-center gap-2 mt-2 text-xs text-slate-500">
                        <span class="inline-flex items-center gap-1 text-teal-700 font-semibold bg-teal-50 px-2 py-0.5 rounded-md border border-teal-200/50">
                          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                          {{ 'Visiting: 5:00 PM - 9:00 PM (Sat - Thu)'|t }}
                        </span>
                        <span>•</span>
                        <span>{{ 'Room & Serial at Reception'|t }}</span>
                      </div>
                    </div>
                  </div>

                  <a href="#booking-card" class="hidden sm:inline-flex items-center gap-1 text-xs font-bold text-teal-700 bg-white hover:bg-teal-50 border border-teal-200 px-3 py-1.5 rounded-lg no-underline transition-colors flex-shrink-0">
                    {{ 'Select Chamber'|t }}
                  </a>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Qualifications & Degrees Section -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-6">
        <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
          <div class="h-10 w-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
          </div>
          <div>
            <h2 class="text-xl font-black text-slate-900">{{ 'Educational Qualifications'|t }}</h2>
            <p class="text-xs text-slate-500">{{ 'Verified medical degrees and academic accreditations'|t }}</p>
          </div>
        </div>

        {% if doctor_data.degrees is empty %}
          <p class="text-sm text-slate-400 italic py-4">{{ 'No educational degrees listed.'|t }}</p>
        {% else %}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {% for deg in doctor_data.degrees %}
              <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center gap-3">
                <div class="h-8 w-8 rounded-lg bg-indigo-100/80 text-indigo-700 flex items-center justify-center font-bold text-xs flex-shrink-0">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div>
                  <div class="text-sm font-bold text-slate-900">{{ deg }}</div>
                  <div class="text-[11px] font-semibold text-slate-500">{{ 'Medical Accreditation'|t }}</div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Overview & Patient Care Policy -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
        <h2 class="text-lg font-black text-slate-900">{{ 'About Consultation & Practice'|t }}</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          {{ doctor_data.title }} is a renowned specialist in <strong class="text-slate-900">{{ doctor_data.specialty }}</strong> with over <strong class="text-slate-900">{{ doctor_data.experience ?: '10+' }} years</strong> of clinical and hospital experience. Committed to comprehensive patient diagnosis, clinical evidence-based care, and accessible consultation protocols across registered chamber locations.
        </p>
        <div class="pt-2 flex flex-wrap gap-4 text-xs font-semibold text-slate-600 border-t border-slate-100">
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            {{ 'Free Follow-up within 7 Days'|t }}
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            {{ 'Digital Prescription & Report Analysis'|t }}
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            {{ 'Instant Serial Confirmation'|t }}
          </div>
        </div>
      </div>

    </div>

    <!-- Right Sidebar Column (1/3) -->
    <div class="space-y-6">

      <!-- Fast Appointment Booking Widget (Sticky) -->
      <div id="booking-card" class="bg-white p-6 sm:p-7 rounded-3xl border border-teal-200/80 shadow-md shadow-teal-600/5 space-y-6 sticky top-24">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div>
            <span class="text-[11px] font-bold text-teal-700 uppercase tracking-wider">{{ 'Book Consultation'|t }}</span>
            <div class="text-2xl font-black text-slate-900 mt-0.5">
              {% if doctor_data.fee %}৳{{ doctor_data.fee }}{% else %}৳500{% endif %}
              <span class="text-xs font-semibold text-slate-400">/ {{ 'session'|t }}</span>
            </div>
          </div>
          <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700 border border-emerald-200/60">
            {{ 'Slots Open'|t }}
          </span>
        </div>

        <!-- Chamber Selector -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-slate-800">{{ 'Select Visiting Chamber'|t }}</label>
          {% if doctor_data.chambers is not empty %}
            <select class="w-full h-11 px-3.5 py-2 text-sm font-sans rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:border-teal-600 focus:bg-white focus:ring-2 focus:ring-teal-500/20 outline-none transition-all">
              {% for chamber in doctor_data.chambers %}
                <option value="{{ chamber }}">{{ chamber }}</option>
              {% endfor %}
            </select>
          {% else %}
            <div class="text-xs text-slate-400">{{ 'No chamber selected'|t }}</div>
          {% endif %}
        </div>

        <!-- Preferred Timing Pills -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-slate-800">{{ 'Available Time Slots'|t }}</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" class="py-2.5 px-3 rounded-xl border border-teal-600 bg-teal-50/80 text-teal-800 font-bold text-xs text-center cursor-pointer transition-all">
              {{ 'Today, 6:00 PM'|t }}
            </button>
            <button type="button" class="py-2.5 px-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs text-center cursor-pointer transition-all">
              {{ 'Tomorrow, 5:30 PM'|t }}
            </button>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="pt-2">
          <button type="button" class="w-full flex items-center justify-center gap-2 h-12 px-6 text-sm font-bold text-white bg-gradient-to-r from-teal-600 to-emerald-600 hover:from-teal-700 hover:to-emerald-700 rounded-xl cursor-pointer shadow-md shadow-teal-600/30 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all border-0 text-center">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span>{{ 'Confirm Appointment Booking'|t }}</span>
          </button>
        </div>

        <!-- Trust Badges -->
        <div class="space-y-2 pt-2 border-t border-slate-100 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            <span>{{ 'Instant SMS Serial Confirmation'|t }}</span>
          </div>
          <div class="flex items-center gap-2">
