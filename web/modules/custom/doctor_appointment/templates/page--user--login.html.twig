{#
/**
 * @file
 * Dedicated authentication page layout for MediCare Hub.
 * Bypasses Olivero's default layout with a modern clinical portal login experience.
 */
#}
<div class="doctor-appointment-shell min-h-screen flex flex-col bg-gradient-to-b from-slate-50 via-teal-50/20 to-slate-100 text-slate-800 antialiased font-sans">
  
  <!-- Minimal Top Header -->
  <header class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-50 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 text-slate-900 no-underline group">
        <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-teal-600 via-emerald-600 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-teal-500/20 group-hover:scale-105 transition-transform">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
          </svg>
        </div>
        <div>
          <div class="font-extrabold text-lg tracking-tight text-slate-900 leading-none">MediCare<span class="text-teal-600">Hub</span></div>
          <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider mt-0.5">{{ 'Appointment System'|t }}</div>
        </div>
      </a>
      
      <div class="flex items-center gap-4">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-teal-600 transition-colors">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          {{ 'Back to Home'|t }}
        </a>
      </div>
    </div>
  </header>

  <!-- Login Main Content Area -->
  <main class="flex-1 flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-6">
      
      <!-- Brand & Title Header -->
      <div class="text-center space-y-2">
        <div class="inline-flex items-center gap-1.5 rounded-full bg-teal-50 px-3 py-1 text-xs font-bold text-teal-700 ring-1 ring-teal-600/20">
          <span class="h-1.5 w-1.5 rounded-full bg-teal-600 animate-pulse"></span>
          {{ 'PORTAL AUTHENTICATION'|t }}
        </div>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
          {{ 'Sign in to your account'|t }}
        </h1>
        <p class="text-xs sm:text-sm text-slate-500">
          {{ 'Access clinical workstation, chamber bookings, or patient profile'|t }}
        </p>
      </div>

      <!-- Messages / Errors Slot -->
      {% if page.highlighted %}
        <div class="da-auth-messages">
          {{ page.highlighted }}
        </div>
      {% endif %}

      <!-- Card Container for Login Form -->
      <div class="da-login-card p-6 sm:p-8 bg-white border border-slate-200/80 rounded-2xl shadow-xl shadow-slate-200/50">
        {{ page.content }}
      </div>

      <!-- Quick Fill Credentials Box for pair testing -->
      <div class="rounded-xl border border-slate-200/80 bg-white/90 backdrop-blur-sm p-4 text-xs shadow-sm">
        <div class="font-bold text-slate-700 mb-2 flex items-center justify-between">
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            {{ 'Demo Quick-Fill Credentials'|t }}
          </span>
          <span class="text-[11px] font-mono bg-slate-100 text-slate-600 px-2 py-0.5 rounded border border-slate-200">{{ 'PW: Test@1234'|t }}</span>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <button type="button" onclick="fillLoginForm('test_doctor')" class="px-2.5 py-2 rounded-lg bg-teal-50 hover:bg-teal-100 text-teal-800 font-semibold border border-teal-200/80 transition-colors text-center shadow-xs cursor-pointer">
            👨‍⚕️ Doctor
          </button>
          <button type="button" onclick="fillLoginForm('test_patient')" class="px-2.5 py-2 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-semibold border border-emerald-200/80 transition-colors text-center shadow-xs cursor-pointer">
            🩺 Patient
          </button>
          <button type="button" onclick="fillLoginForm('admin')" class="px-2.5 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold border border-slate-300 transition-colors text-center shadow-xs cursor-pointer">
            ⚙️ Admin
          </button>
        </div>
      </div>

      <!-- Security Guarantee Note -->
      <div class="text-center text-xs text-slate-500 flex items-center justify-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        <span>{{ 'Protected by 256-bit SSL encryption & Drupal 11 Engine'|t }}</span>
      </div>

    </div>
  </main>

  <!-- Clean Minimal Footer -->
  <footer class="bg-white border-t border-slate-200/80 py-4 text-center text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 flex items-center justify-between">
      <span>MediCare Hub · Doctor Appointment Booking System</span>
      <a href="/user/password" class="text-teal-600 hover:underline">{{ 'Forgot password?'|t }}</a>
    </div>
  </footer>
</div>

<script>
function fillLoginForm(username) {
  var userField = document.querySelector('input[name="name"]');
  var passField = document.querySelector('input[name="pass"]');
  if (userField) {
    userField.value = username;
    userField.dispatchEvent(new Event('input', { bubbles: true }));
    userField.dispatchEvent(new Event('change', { bubbles: true }));
  }
  if (passField) {
    passField.value = 'Test@1234';
    passField.dispatchEvent(new Event('input', { bubbles: true }));
    passField.dispatchEvent(new Event('change', { bubbles: true }));
  }
  if (userField) {
    userField.focus();
  }
}
</script>
